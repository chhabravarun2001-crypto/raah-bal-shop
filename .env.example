# --- Shopify (RAAH | BAL storefront) --------------------------------------
# Leave both blank to run on the built-in placeholder catalogue (mock-data.ts)
# with the stock product photography already in public/images/products.
# Fill them in once a Shopify store exists to go live with real inventory —
# no code changes needed. Create a custom app in Shopify Admin > Settings >
# Apps and sales channels > Develop apps, enable the Storefront API, and copy
# the values below.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# --- Google sign-in (Auth.js) ----------------------------------------------
# Leave blank to show the "Google sign-in — connecting soon" disabled state
# on /account. Create an OAuth client at console.cloud.google.com >
# APIs & Services > Credentials (type: Web application), with an authorized
# redirect URI of "<your-domain>/api/auth/callback/google".
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Random secret used to sign session cookies — generate with:
#   openssl rand -base64 32
AUTH_SECRET=

# --- Newsletter (optional) --------------------------------------------------
# URL of a webhook (e.g. a Google Apps Script Web App) that appends footer
# newsletter signups to a spreadsheet or CRM. Leave blank to just log
# signups server-side instead of failing.
NEWSLETTER_WEBHOOK_URL=
